rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files for viewing course content.
    match /{allPaths=**} {
      allow get: if true;
    }

    // Allow any authenticated user to write to storage.
    // UI access to this functionality is protected by the ProtectRoute component,
    // which checks for the isAdmin field in the user's Firestore document.
    match /{allPaths=**} {
       allow write: if request.auth != null;
    }
  }
}
